# Timezone used for "today"/"tomorrow" boundaries and the workout lookup.
HOME_TIMEZONE=America/Denver
# Same value, exposed client-side so the Clock renders correctly before
# hydration (the server render would otherwise default to UTC).
NEXT_PUBLIC_HOME_TIMEZONE=America/Denver

# --- Weather (Open-Meteo, no key needed) ---
HOME_LAT=
HOME_LON=

# --- Commute (TomTom Routing API) ---
TOMTOM_API_KEY=
# "lat,lon" strings
HOME_COORDS=
WORK_COORDS=

# --- Traffic map (TomTom Maps SDK, runs client-side so these ship to the browser) ---
NEXT_PUBLIC_TOMTOM_API_KEY=
NEXT_PUBLIC_HOME_COORDS=
NEXT_PUBLIC_WORK_COORDS=

# --- Calendar (Google Calendar API, one OAuth client, two authorized accounts) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_WORK_REFRESH_TOKEN=
GOOGLE_PERSONAL_REFRESH_TOKEN=
